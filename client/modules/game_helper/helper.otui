HelperTitulo < Label
  font: verdana-11px-rounded
  color: #f0ad4d
  text-align: left
  height: 18

HelperInfo < Label
  text-align: left
  height: 16
  color: #aaaaaa

# Linha com magia digitada e limiar de porcentagem.
HelperLinhaMagia < Panel
  height: 26

  CheckBox
    id: ativo
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 18

  TextEdit
    id: valor
    anchors.left: ativo.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 120

  SpinBox
    id: porcento
    anchors.left: valor.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 58

  Label
    id: sufixo
    anchors.left: porcento.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    width: 16
    text-align: left
    !text: '%'

# Linha com item escolhido da mochila. O slot aceita o item arrastado e o botao
# abre o seletor por clique, que e o mesmo mecanismo das hotkeys do client.
HelperLinhaItem < Panel
  height: 36

  CheckBox
    id: ativo
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 18

  Item
    id: item
    anchors.left: ativo.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    virtual: true

  Button
    id: escolher
    anchors.left: item.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 64
    !text: tr('Escolher')

  SpinBox
    id: porcento
    anchors.left: escolher.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 54

  Label
    id: sufixo
    anchors.left: porcento.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    width: 16
    text-align: left
    !text: '%'

# Linha de liga-desliga, sem parametro.
HelperLinhaSimples < Panel
  height: 24

  CheckBox
    id: ativo
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 18

  Label
    id: rotulo
    anchors.left: ativo.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    anchors.right: parent.right
    text-align: left

# Linha com texto livre, sem porcentagem.
HelperLinhaTexto < Panel
  height: 26

  CheckBox
    id: ativo
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 18

  TextEdit
    id: valor
    anchors.left: ativo.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 160

MainWindow
  id: helperWindow
  !text: tr('Assistente')
  size: 764 340
  @onEscape: modules.game_helper.toggle()

  # ----- coluna da esquerda -----
  Label
    id: personagem
    anchors.top: parent.top
    anchors.left: parent.left
    width: 200
    height: 18
    text-align: left
    font: verdana-11px-rounded

  HelperInfo
    id: status
    anchors.top: personagem.bottom
    anchors.left: parent.left
    width: 200
    margin-top: 2

  HelperTitulo
    id: tituloHaste
    anchors.top: status.bottom
    anchors.left: parent.left
    width: 200
    margin-top: 14
    !text: tr('Auto haste')

  HelperLinhaTexto
    id: haste
    anchors.top: tituloHaste.bottom
    anchors.left: parent.left
    width: 200
    margin-top: 2

  HelperTitulo
    id: tituloOutros
    anchors.top: haste.bottom
    anchors.left: parent.left
    width: 200
    margin-top: 14
    !text: tr('Outras ferramentas')

  HelperLinhaSimples
    id: comer
    anchors.top: tituloOutros.bottom
    anchors.left: parent.left
    width: 200
    margin-top: 2

  HelperLinhaSimples
    id: reconectar
    anchors.top: comer.bottom
    anchors.left: parent.left
    width: 200

  # ----- coluna do meio: magias -----
  HelperTitulo
    id: tituloMagias
    anchors.top: parent.top
    anchors.left: personagem.right
    margin-left: 16
    width: 240
    !text: tr('Cura por magia')

  HelperLinhaMagia
    id: magia1
    anchors.top: tituloMagias.bottom
    anchors.left: tituloMagias.left
    width: 240
    margin-top: 2

  HelperLinhaMagia
    id: magia2
    anchors.top: magia1.bottom
    anchors.left: tituloMagias.left
    width: 240

  HelperLinhaMagia
    id: magia3
    anchors.top: magia2.bottom
    anchors.left: tituloMagias.left
    width: 240

  HelperTitulo
    id: tituloMana
    anchors.top: magia3.bottom
    anchors.left: tituloMagias.left
    width: 240
    margin-top: 14
    !text: tr('Treino de mana (mana acima de)')

  HelperLinhaMagia
    id: mana
    anchors.top: tituloMana.bottom
    anchors.left: tituloMagias.left
    width: 240
    margin-top: 2

  # ----- coluna da direita: itens -----
  HelperTitulo
    id: tituloItens
    anchors.top: parent.top
    anchors.left: tituloMagias.right
    margin-left: 16
    anchors.right: parent.right
    !text: tr('Cura por item (pocao ou runa)')

  HelperLinhaItem
    id: item1
    anchors.top: tituloItens.bottom
    anchors.left: tituloItens.left
    anchors.right: parent.right
    margin-top: 2

  HelperLinhaItem
    id: item2
    anchors.top: item1.bottom
    anchors.left: tituloItens.left
    anchors.right: parent.right

  HelperLinhaItem
    id: item3
    anchors.top: item2.bottom
    anchors.left: tituloItens.left
    anchors.right: parent.right

  HelperTitulo
    id: tituloRunas
    anchors.top: item3.bottom
    anchors.left: tituloItens.left
    anchors.right: parent.right
    margin-top: 12
    !text: tr('Runa no alvo (vida do alvo ate)')

  HelperLinhaItem
    id: runa1
    anchors.top: tituloRunas.bottom
    anchors.left: tituloItens.left
    anchors.right: parent.right
    margin-top: 2

  HelperLinhaItem
    id: runa2
    anchors.top: runa1.bottom
    anchors.left: tituloItens.left
    anchors.right: parent.right

  # ----- rodape -----
  HelperInfo
    id: aviso
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: separador.top
    margin-bottom: 6
    height: 16
    !text: tr('Arraste o item para o quadro ou use Escolher. Clique com o botao direito no quadro para limpar.')

  HorizontalSeparator
    id: separador
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: fechar.top
    margin-bottom: 8

  Button
    id: exportar
    !text: tr('Exportar')
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 80
    @onClick: modules.game_helper.exportar()

  Button
    id: importar
    !text: tr('Importar')
    anchors.left: exportar.right
    anchors.bottom: parent.bottom
    margin-left: 6
    width: 80
    @onClick: modules.game_helper.importar()

  Button
    id: fechar
    !text: tr('Fechar')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    @onClick: modules.game_helper.toggle()
