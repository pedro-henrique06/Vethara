# HTTPS automático via Let's Encrypt. O Caddy cuida do certificado e da renovação
# sozinho — o único requisito é o domínio já apontar para o IP do VPS antes de subir.

{$VETHARA_DOMAIN} {
	encode gzip

	# O client 13+ não conecta por IP: ele faz POST no login web service.
	# Este é o endereço que vai no init.lua do client.
	handle /login* {
		reverse_proxy login-server:8088
	}

	# Download do client. Os arquivos ficam em ~/Vethara/download no VPS e nao
	# entram no git: o zip tem dezenas de MB e o exe e reconstruivel.
	#
	# handle_path (e nao handle) porque o prefixo precisa sair da URL: com "handle",
	# o pedido /download/arquivo.zip vira /srv/download/download/arquivo.zip e da 404.
	redir /download /download/
	handle_path /download/* {
		root * /srv/download
		file_server browse
	}

	# Arquivos que o updater do client baixa. Servidos direto de client/ no
	# repositorio, que ja esta no VPS depois do git pull — entao um push na main
	# vira atualizacao de client sem nenhum passo a mais.
	#
	# handle_path remove o prefixo: /client/init.lua -> /srv/client/init.lua, que e
	# exatamente o caminho que o manifesto anuncia.
	handle_path /client/* {
		root * /srv/client
		file_server
	}

	# API do site novo.
	handle /api/* {
		reverse_proxy api:8080
	}

	# MyAAC, agora num subcaminho: cuida de criacao de conta e do painel
	# administrativo ate a API assumir essas partes. handle_path remove o
	# prefixo, entao o MyAAC continua vendo os caminhos que espera.
	redir /aac /aac/
	handle_path /aac/* {
		reverse_proxy myaac:80
	}

	# Todo o resto e o site em React.
	handle {
		reverse_proxy web:80
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
